<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@color/background_light">

    <!-- Header Section with Gradient Feel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/primary">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PicFlow"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photo Magic Editor"
            android:textSize="14sp"
            android:textColor="@color/primary_light"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Image Preview Box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@color/white"
                android:layout_marginBottom="24dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/imageViewPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/gray_light"
                    android:scaleType="centerInside" />

                <!-- Placeholder Text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Pick or take a photo to start ✨"
                    android:textSize="16sp"
                    android:textColor="@color/text_light"
                    android:gravity="center"
                    android:id="@+id/placeholderText" />

            </FrameLayout>

            <!-- Action Buttons - Large and Easy to Tap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:spacing="12dp">

                <Button
                    android:id="@+id/btnGallery"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:text="📸\nGallery"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/text_white"
                    android:lineSpacingExtra="2sp" />

                <Button
                    android:id="@+id/btnCamera"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:text="📷\nCamera"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/text_white"
                    android:lineSpacingExtra="2sp" />

            </LinearLayout>

            <!-- Edit Button - Main CTA -->
            <Button
                android:id="@+id/btnEdit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="✨ Start Editing"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/success"
                android:elevation="4dp" />

            <!-- Info Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_marginTop="20dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Features"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✨ Adjust brightness & colors\n🎂 Add birthday greetings\n🌟 Remove backgrounds\n💎 Enhance quality"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
